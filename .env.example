# Copy to .env to override a default. Never commit .env.

# Needed to extract job requirements. Calls are billed to this key.
ANTHROPIC_API_KEY=

# Model used for extraction (default: claude-opus-5-5)
# FITGRID_MODEL=

# Host ports (defaults shown)
# WEB_PORT=5180
# API_PORT=8100
# DB_PORT=5434

# Local development database password (default: fitgrid)
# POSTGRES_PASSWORD=
