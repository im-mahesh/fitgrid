# Copy to .env to override a default. Never commit .env.

# Needed to extract requirements, compare a resume and chat. Calls are billed to this key.
ANTHROPIC_API_KEY=

# Model used for extraction, matching and chat (default: claude-sonnet-5-5)
# FITGRID_MODEL=

# Host ports (defaults shown)
# WEB_PORT=5180
# API_PORT=8100
# DB_PORT=5434

# Local development database password (default: fitgrid)
# POSTGRES_PASSWORD=
